# Copy to .env.production and replace all example values before deploying.
# This file contains public Firebase web-app config, not private server credentials.
VITE_API_URL=https://api.example.invalid
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=replace-me
